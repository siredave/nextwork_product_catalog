{
  "info": {
    "name": "Product Catalog API",
    "description": "Postman collection to test the Product Catalog API (local dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": [
        {
          "name": "Health response",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{ \"message\": \"API is healthy\" }"
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "5" }
          ]
        }
      },
      "response": [
        {
          "name": "List sample",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"success\": true,\n  \"data\": [ { \"_id\": \"64f9a1...\", \"name\": \"Laptop\", \"price\": 1299.99, \"category\": \"electronics\", \"imageUrl\": null } ],\n  \"meta\": { \"total\": 1, \"page\": 1, \"limit\": 5, \"pages\": 1 }\n}"
        }
      ]
    },
    {
      "name": "Get product",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/products/<PRODUCT_ID>", "host": ["{{baseUrl}}"], "path": ["products", "<PRODUCT_ID>"] }
      },
      "response": [
        {
          "name": "Get sample",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{ \"success\": true, \"data\": { \"_id\": \"64f9a1...\", \"name\": \"Laptop\", \"price\": 1299.99, \"category\": \"electronics\", \"description\": \"A powerful laptop\", \"imageUrl\": null } }"
        }
      ]
    },
    {
      "name": "Create product (form-data with image)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "My Product", "type": "text" },
            { "key": "price", "value": "19.99", "type": "text" },
            { "key": "category", "value": "toys", "type": "text" },
            { "key": "description", "value": "Nice toy", "type": "text" },
            { "key": "image", "type": "file", "src": ["/path/to/image.jpg"] }
          ]
        },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      },
      "response": [
        {
          "name": "Create sample (with image)",
          "originalRequest": {},
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "body": "{ \"success\": true, \"data\": { \"_id\": \"6500b2...\", \"name\": \"My Product\", \"price\": 19.99, \"category\": \"toys\", \"description\": \"Nice toy\", \"imageUrl\": \"https://res.cloudinary.com/.../image.jpg\", \"imagePublicId\": \"products/abc123\" } }"
        }
      ]
    },
    {
      "name": "Create product (raw JSON)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My Product\",\n  \"price\": 19.99,\n  \"category\": \"toys\",\n  \"description\": \"Nice toy\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      },
      "response": []
    },
    {
      "name": "Update product (raw JSON)",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Updated Name\", \"price\": 29.99 }",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/products/<PRODUCT_ID>", "host": ["{{baseUrl}}"], "path": ["products", "<PRODUCT_ID>"] }
      },
      "response": [
        {
          "name": "Update sample",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{ \"success\": true, \"data\": { \"_id\": \"6500b2...\", \"name\": \"Updated Name\", \"price\": 29.99 } }"
        }
      ]
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/<PRODUCT_ID>", "host": ["{{baseUrl}}"], "path": ["products", "<PRODUCT_ID>"] }
      },
      "response": [
        {
          "name": "Delete sample",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{ \"success\": true, \"data\": { \"_id\": \"6500b2...\", \"name\": \"Updated Name\" } }"
        }
      ]
    }
  ]
}
